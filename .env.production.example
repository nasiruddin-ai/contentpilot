# Production settings for docker-compose.prod.yml. On the server, run
#   ./deploy/init-env.sh your-domain.example.com you@example.com
# to create .env from this file with fresh secrets, then fill in the keys below.
# Never commit .env or copy it anywhere public.

# --- Address -----------------------------------------------------------------
# The public domain (no https://), and an email Let's Encrypt can reach about certificates.
DOMAIN=contentpilot.example.com
ACME_EMAIL=you@example.com
APP_URL=https://contentpilot.example.com
API_URL=https://contentpilot.example.com
LOG_LEVEL=INFO

# --- Secrets (generated by init-env.sh) --------------------------------------------
POSTGRES_PASSWORD=
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=

# --- AI ----------------------------------------------------------------------
# https://aistudio.google.com/apikey. On the free tier Google may use prompts to improve
# its products; use a paid key before real customers use the app.
GOOGLE_AI_API_KEY=
# Free tier: gemini-3.5-flash is more reliable than the default quality model.
# GEMINI_QUALITY_MODEL=gemini-3.5-flash

# --- Facebook Pages (developers.facebook.com) ---------------------------------------
# Add https://YOUR-DOMAIN/api/v1/social/facebook/callback under
# Facebook Login for Business → Settings → Valid OAuth Redirect URIs.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_LOGIN_CONFIG_ID=

# --- Optional: LinkedIn and X --------------------------------------------------------
# Redirect URLs: https://YOUR-DOMAIN/api/v1/social/linkedin/callback and .../x/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
