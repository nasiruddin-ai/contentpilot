# Copy to .env and fill in. Never commit .env.

APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
LOG_LEVEL=INFO
# Comma-separated; defaults to APP_URL when empty
CORS_ORIGINS=

# docker-compose overrides these four to point at its own containers
DATABASE_URL=postgresql+psycopg://contentpilot:contentpilot@localhost:5433/contentpilot
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Gemini key from https://aistudio.google.com/apikey (free tier available)
GOOGLE_AI_API_KEY=
# Optional model overrides (defaults: gemini-3.5-flash-lite, gemini-3.8-flash, gemini-embedding-2)
# GEMINI_FAST_MODEL=
# GEMINI_QUALITY_MODEL=
# GEMINI_EMBEDDING_MODEL=

# Generated images. Only "local" exists so far (Docker volume, served at API_URL/media).
STORAGE_BACKEND=local

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=

# Encrypts social account tokens. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# LinkedIn app: https://www.linkedin.com/developers/apps (products: Share on LinkedIn,
# Sign In with LinkedIn using OpenID Connect). Redirect URL: API_URL/api/v1/social/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_API_VERSION=202609

# Meta app (developers.facebook.com): App ID and App secret. Redirect URL: API_URL/api/v1/social/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# FACEBOOK_GRAPH_VERSION=v25.0
# For apps using Facebook Login for Business: the Configuration ID
# FACEBOOK_LOGIN_CONFIG_ID=

X_CLIENT_ID=
X_CLIENT_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
